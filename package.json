{
  "name": "attend",
  "version": "0.0.0",
  "description": "The attention layer for agents: decide when an event should wake your agent.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asher-aqi/attend.git"
  },
  "keywords": [
    "agents",
    "mcp",
    "mcp-events",
    "attention",
    "llm",
    "proactive-agents",
    "debounce",
    "event-driven"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
