{
  "name": "attend",
  "version": "0.1.0",
  "description": "The attention layer for agents: decide when an event should wake your agent.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acquiredintelligence/attend.git"
  },
  "keywords": [
    "agents",
    "mcp",
    "mcp-events",
    "attention",
    "llm",
    "proactive-agents",
    "debounce",
    "event-driven"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "attend": "./dist/cli.js"
  },
  "packageManager": "pnpm@12.8.1",
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "default": "./dist/llm.js"
    },
    "./decisions": {
      "types": "./dist/decisions.d.ts",
      "default": "./dist/decisions.js"
    },
    "./jev": {
      "types": "./dist/jev.d.ts",
      "default": "./dist/jev.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:docs",
    "demo": "pnpm build && node --experimental-strip-types examples/demo.ts",
    "check:docs": "node scripts/check-snippets.mjs",
    "test:oracle": "vitest run -c vitest.oracle.config.ts",
    "bench:selfcheck": "pnpm build && vitest run -c bench/vitest.config.mjs",
    "bench:openloop": "node bench/openloop.mjs",
    "bench:latency": "node bench/latency.mjs",
    "bench:stores": "node bench/stores.mjs",
    "bench:alloc": "node bench/alloc.mjs",
    "bench:suite": "node bench/suite.mjs",
    "bench:validate": "node bench/validate.mjs",
    "bench:gates": "node bench/gates.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/acquiredintelligence/attend#readme",
  "bugs": {
    "url": "https://github.com/acquiredintelligence/attend/issues"
  },
  "author": "Zettel Labs, Inc."
}
